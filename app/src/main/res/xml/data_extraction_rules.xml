<?xml version="1.0" encoding="utf-8"?>
<!-- API 31 and up: cloud backup and device transfer both skip the WebView data (Amazon session cookies). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="app_webview" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="app_webview" />
    </device-transfer>
</data-extraction-rules>
